{
    "rules": {
        ".read": false,
        ".write": false,
        "usuarios": {
            "$uid": {
                ".read": "$uid === auth.uid",
                ".write": "$uid === auth.uid"
            }
        },
        "invernaderos": {
            "$invId": {
                ".read": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()",
                ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()",
                "control": {
                    ".read": true,
                    ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()"
                },
                "controlAutomatico": {
                    ".read": true,
                    ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()"
                },
                "sensores": {
                    ".read": true,
                    ".write": true
                },
                "secciones": {
                    "$secId": {
                        ".read": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()",
                        ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()",
                        "control": {
                            ".read": true,
                            ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()"
                        },
                        "controlAutomatico": {
                            ".read": true,
                            ".write": "auth !== null && root.child('usuarios/' + auth.uid + '/invernaderos/' + $invId).exists()"
                        },
                        "sensores": {
                            ".read": true,
                            ".write": true
                        }
                    }
                }
            }
        },
        "modulos": {
            ".read": "auth !== null",
            "$moduloId": {
                ".read": true,
                "invernaderoId": {
                    ".read": true,
                    ".write": "auth !== null && (newData.val() === null || root.child('usuarios/' + auth.uid + '/invernaderos/' + newData.val()).exists()) && (data.val() === null || !data.exists() || root.child('usuarios/' + auth.uid + '/invernaderos/' + data.val()).exists())"
                },
                "seccionId": {
                    ".read": true,
                    ".write": "auth !== null"
                },
                "timestamp": {
                    ".write": true
                },
                "online": {
                    ".write": true
                },
                "ip": {
                    ".write": true
                },
                "lastLinkedAt": {
                    ".write": "auth !== null"
                }
            }
        }
    }
}
